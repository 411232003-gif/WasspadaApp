rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Registered accounts only (email/password, Google, ...). Anonymous
    // sign-in does not count — guests cannot write.
    function isMember() {
      return isAuthenticated()
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Public alert feed. Anyone can read; only authenticated users can post,
    // and they must tag the alert with their own uid.
    match /disaster_alerts/{doc} {
      allow read: if true;
      allow create: if isAuthenticated()
                     && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated()
                             && resource.data.userId == request.auth.uid;
    }

    // Public community chat. Only registered (non-anonymous) members can
    // post and like. Messages must be tagged with the sender's own uid.
    match /community_messages/{doc} {
      allow read: if isMember();
      allow create: if isMember()
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.text is string
                     && request.resource.data.text.size() <= 500
                     && request.resource.data.name is string
                     && request.resource.data.name.size() <= 40
                     && request.resource.data.likes is list
                     && (!('imageUrl' in request.resource.data)
                         || request.resource.data.imageUrl is string)
                     && (!('photoUrl' in request.resource.data)
                         || request.resource.data.photoUrl is string)
                     && (!('parentId' in request.resource.data)
                         || request.resource.data.parentId is string);
      allow update: if isMember()
                     && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['likes'])
                     && request.resource.data.likes is list;
      allow delete: if false;
    }

    // User profiles (display name, birth date, photo). Members can read
    // any profile (needed for chat avatars); only the owner can write.
    match /profiles/{userId} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == userId;
    }

    // User-scoped bookmarks and subscriptions.
    match /users/{userId} {
      match /kelurahan_bookmarks/{doc} {
        allow read, create, update, delete: if isOwner(userId);
      }
      match /alert_subscriptions/{doc} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }
  }
}

# ============================================================
# WasspadaApp — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya.
# ============================================================

# ------------------------------------------------------------
# FIREBASE (wajib untuk chat, alert, bookmark)
# Sumber: https://console.firebase.google.com
#   -> Project Settings (roda gigi) -> General
#   -> scroll ke "Your apps" -> Web app -> Config
# Jangan lupa aktifkan: Authentication -> Sign-in method -> Anonymous
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------
# SUPABASE STORAGE (opsional - untuk kirim foto di chat)
# Sumber: https://supabase.com/dashboard -> project -> Settings -> API
# Buat bucket PUBLIC bernama "chat-images" di Storage, lalu
# jalankan policy insert+delete via SQL Editor.
# Foto otomatis di-resize < 5 MB dan dihapus setelah 5 hari.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=chat-images

# ------------------------------------------------------------
# RELIEFWEB (opsional - sumber berita UN OCHA di /news)
# Daftar appname gratis via form di:
#   https://apidoc.reliefweb.int/parameters#appname
# ------------------------------------------------------------
RELIEFWEB_APPNAME=

# ------------------------------------------------------------
# PENGATURAN APLIKASI (opsional)
# ------------------------------------------------------------
# Gunung api yang dipantau untuk alert banner (default: Merapi)
NEXT_PUBLIC_TARGET_VOLCANO=Merapi
# Provider tile peta awal: "esri-street" (default) atau "osm"
NEXT_PUBLIC_DEFAULT_TILE_PROVIDER=esri-street
